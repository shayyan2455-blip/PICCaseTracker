VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Gmail SMTP for reminder emails (enable "App Passwords" in Google Account security)
GMAIL_SMTP_USER=your-email@gmail.com
GMAIL_SMTP_PASS=your-16-character-app-password

# Supabase service_role key (for server-side APIs to bypass RLS)
# Find this in: Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
